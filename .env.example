# Backend / MongoDB
# Never commit the real values. Configure production values in your hosting provider.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mental_health_companion?retryWrites=true&w=majority
MONGODB_DB_NAME=mental_health_companion

# Authentication
# Generate a long random value for every environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
# Local development uses http://localhost:8000.
# On Render, use the public URL of the deployed FastAPI service.
API_URL=http://localhost:8000

# Deployment
PYTHON_VERSION=3.11.11
